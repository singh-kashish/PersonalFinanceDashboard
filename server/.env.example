# ── Server environment variables ──────────────────────────────────
# Copy to .env and fill in real values.  Never commit .env itself.

NODE_ENV=development

# ── Database (local docker-compose postgres-dev) ─────────────────
DATABASE_URL=postgresql://flo:flo_local@localhost:5442/flo_dev

# ── Redis (local docker-compose redis) ───────────────────────────
REDIS_URL=redis://localhost:6380

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-at-least-30-characters-long-secret
JWT_REFRESH_SECRET=change-me-to-another-30-characters-long-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Server ───────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173
