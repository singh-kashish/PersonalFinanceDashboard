# ── Test environment variables ────────────────────────────────────
# Copy to .env.test and fill in real values.  Never commit .env.test itself.
# The test harness validates that DATABASE_URL points to localhost
# and the database name ends in _test.

NODE_ENV=test

# ── Database (local docker-compose postgres-test, tmpfs) ─────────
DATABASE_URL=postgresql://flo:flo_local@localhost:5443/flo_test

# ── Redis (local docker-compose redis) ───────────────────────────
REDIS_URL=redis://localhost:6380

# ── JWT (test-only secrets, need not be secure) ──────────────────
JWT_ACCESS_SECRET=test-access-secret-at-least-thirty-chars!!
JWT_REFRESH_SECRET=test-refresh-secret-at-least-thirty-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Server ───────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
